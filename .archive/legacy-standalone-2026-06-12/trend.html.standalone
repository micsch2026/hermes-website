<button id="theme-toggle" aria-label="Theme wechseln" title="Theme wechseln" style="background:none;border:none;cursor:pointer;color:var(--c-text-muted);padding:var(--s-2);border-radius:var(--r-sm);display:flex;align-items:center;margin-left:auto;transition:color var(--t)">
    <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
    <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </button>
</nav>
<script>
(function(){
  var btn = document.getElementById('theme-toggle');
  var iconSun = document.getElementById('icon-sun');
  var iconMoon = document.getElementById('icon-moon');
  function setTheme(t){
    document.documentElement.className = t;
    localStorage.setItem('theme', t);
    if(iconSun) iconSun.style.display = t === 'dark' ? 'none' : 'block';
    if(iconMoon) iconMoon.style.display = t === 'dark' ? 'block' : 'none';
  }
  var current = localStorage.getItem('theme') || 'dark';
  setTheme(current);
  if(btn) btn.addEventListener('click', function(){
    current = current === 'dark' ? 'light' : 'dark';
    setTheme(current);
  });
})();
</script>
</header>

<main>
<!-- ⚠️ AUTO-GENERATED by build_bot_pages.py — DO NOT EDIT MANUALLY!
     Source: src/templates/bot.html + src/data/bots/trend.json
     To change: edit the template/config, then run: cd /root/.hermes/site && python3 build_bot_pages.py -->
<link rel="stylesheet" href="/assets/bot.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script src="https://unpkg.com/lightweight-charts@4.2.1/dist/lightweight-charts.standalone.production.js"></script>
<script src="/assets/bot-components.js"></script>

<!-- 1. STATUS BAR -->
<div class="bot-status-bar">
  <div>
    <span class="bot-status-dot" id="trend-dot"></span>
    <span id="trend-status">Loading...</span>
    <span class="bot-badge" id="trend-mode-badge" style="margin-left:8px"></span>
  </div>
  <span id="trend-last-update" style="color:var(--c-text-dim);font-size:var(--text-xs)">—</span>
</div>

<!-- 1b. HEALTH BANNER -->
<div class="bot-health-banner" id="trend-health-banner">
  <span class="bot-health-icon">⚠️</span>
  <span class="bot-health-text" id="trend-health-text"></span>
  <span class="bot-health-time" id="trend-health-time"></span>
</div>

<!-- 2. STRATEGY INFO -->
<div class="bot-strategy-info">
    <div class="bot-strategy-tag">
    <span class="label">Strategy</span>
    <span class="value">EMA + ADX Crossover — Grid-Search optimiert</span>
  </div>
  <div class="bot-strategy-tag">
    <span class="label">Timeframe</span>
    <span class="value">1H</span>
  </div>
  <div class="bot-strategy-tag">
    <span class="label">Pairs</span>
    <span class="value" id="trend-pairs-count">21 FX Pairs</span>
  </div>
  <div class="bot-strategy-tag">
    <span class="label">Type</span>
    <span class="value">Trend Following</span>
  </div>
</div>

<!-- 3. KPI CARDS -->
<div class="bot-grid" id="trend-kpi-row">
  <div class="bot-card">
    <div class="bot-card-title">Balance</div>
    <div class="bot-card-value" id="trend-balance">—</div>
    <div class="bot-card-sub" id="trend-equity-sub">—</div>
  </div>
  <div class="bot-card">
    <div class="bot-card-title">Open Positions</div>
    <div class="bot-card-value" id="trend-positions-count">—</div>
    <div class="bot-card-sub" id="trend-positions-sub">—</div>
  </div>
  <div class="bot-card">
    <div class="bot-card-title">Daily P&L</div>
    <div class="bot-card-value" id="trend-daily-pnl">—</div>
    <div class="bot-card-sub" id="trend-trades-today">—</div>
  </div>
  <div class="bot-card">
    <div class="bot-card-title">Total P&L</div>
    <div class="bot-card-value" id="trend-total-pnl">—</div>
    <div class="bot-card-sub" id="trend-winrate-sub">—</div>
  </div>
</div>

<!-- 4. PERFORMANCE METRICS -->
<p class="bot-section-title">📊 Performance (Live)</p>
<div class="bot-grid" id="trend-perf-grid">
  <div class="bot-card">
    <div class="bot-card-title">Win Rate</div>
    <div class="bot-card-value" id="trend-winrate">—</div>
    <div class="bot-card-sub" id="trend-winrate-detail">—</div>
  </div>
  <div class="bot-card">
    <div class="bot-card-title">Profit Factor</div>
    <div class="bot-card-value" id="trend-profit-factor">—</div>
    <div class="bot-card-sub">Target: &gt; 1.5</div>
  </div>
  <div class="bot-card">
    <div class="bot-card-title">Expectancy</div>
    <div class="bot-card-value" id="trend-expectancy">—</div>
    <div class="bot-card-sub">Per trade</div>
  </div>
  <div class="bot-card">
    <div class="bot-card-title">Max Drawdown</div>
    <div class="bot-card-value" id="trend-max-dd">—</div>
    <div class="bot-card-sub">Limit: 10%</div>
  </div>
</div>



<!-- 5. EQUITY CURVE -->
<p class="bot-section-title">📈 Equity Curve</p>
<div class="bot-card">
  <div class="bot-chart-container"><canvas id="trend-equity-chart"></canvas></div>
  <div class="bot-chart-summary" id="trend-equity-summary"></div>
</div>


<!-- 6. SIGNAL OVERVIEW -->
<p class="bot-section-title">📡 Signal Overview</p>
<div class="bot-signal-grid" id="trend-signal-grid">
  <div class="bot-signal-card"><div class="bot-no-data">Loading signals...</div></div>
</div>


<!-- 6b. CANDLESTICK CHART PANEL -->
<div class="bot-chart-panel" id="trend-chart-panel">
  <div class="bot-chart-header">
    <div>
      <span class="bot-chart-pair-name" id="trend-chart-pair">—</span>
      <span class="bot-badge bot-badge-signal" id="trend-chart-strategy" style="margin-left:8px"></span>
    </div>
    <div style="display:flex;gap:var(--s-2);align-items:center">
      <button id="trend-trade-toggle" class="bot-chart-close"
        onclick="BotDash.toggleTradeLines()"
        style="background:rgba(34,197,94,0.15);color:#22c55e;border:1px solid rgba(34,197,94,0.3)">
        📊 Trades: ON
      </button>
      <button class="bot-chart-close" onclick="BotDash.closeChart()">✕ Close</button>
    </div>
  </div>
  <div class="bot-pair-nav" id="trend-pair-nav"></div>
  <div class="bot-range-nav" id="trend-range-nav">
    <span class="bot-range-chip bot-range-active" data-days="0" onclick="BotDash.setRange(0)">All</span>
    <span class="bot-range-chip" data-days="90" onclick="BotDash.setRange(90)">3M</span>
    <span class="bot-range-chip" data-days="30" onclick="BotDash.setRange(30)">1M</span>
    <span class="bot-range-chip" data-days="14" onclick="BotDash.setRange(14)">2W</span>
    <span class="bot-range-chip" data-days="7" onclick="BotDash.setRange(7)">1W</span>
  </div>
  <div class="bot-chart-config" id="trend-chart-config"></div>
  <div class="bot-chart-legend" style="display:flex;gap:var(--s-3);flex-wrap:wrap;margin-bottom:var(--s-2);font-size:var(--text-xs);color:var(--c-text-dim)">
    <span><span style="color:#22c55e">━</span> Profit</span>
    <span><span style="color:#ef4444">━</span> Loss</span>
    <span><span style="color:#22c55e">┈</span> Timeout (profit)</span>
    <span><span style="color:#ef4444">┈</span> Timeout (loss)</span>
    <span style="opacity:0.6">Each arrow = one simulated backtest trade</span>
  </div>
  <div class="bot-chart-wrap">
    <div id="trend-candle-chart" style="height:320px"></div>
    <div class="bot-trade-tooltip" id="trend-trade-tooltip"></div>
    <div class="bot-chart-rsi-label">RSI</div>
    <div id="trend-rsi-chart" style="height:100px"></div>
  </div>
</div>

<!-- 7. OPEN POSITIONS -->
<p class="bot-section-title">🔵 Open Positions</p>
<div class="bot-card bot-table-wrap">
  <table class="bot-table">
    <thead><tr><th>Pair</th><th>Direction</th><th>Score</th><th>Entry</th><th>SL</th><th>TP</th><th>Margin</th><th>P&L</th><th>Duration</th></tr></thead>
    <tbody id="trend-positions-body"><tr><td colspan="9" class="bot-no-data">Loading...</td></tr></tbody>
  </table>
</div>

<!-- 8. TRADE HISTORY -->
<p class="bot-section-title">📋 Trade History</p>
<div class="bot-card bot-table-wrap">
  <table class="bot-table">
    <thead><tr><th>Time</th><th>Pair</th><th>Direction</th><th>Entry</th><th>Exit</th><th>P&L</th><th>Duration</th></tr></thead>
    <tbody id="trend-history-body"><tr><td colspan="7" class="bot-no-data">No trades yet</td></tr></tbody>
  </table>
</div>

<!-- 9. STRATEGY DETAILS -->
<p class="bot-section-title">⚙️ Strategy Details</p>
<div class="bot-card">
  <div style="display:flex;flex-wrap:wrap;gap:var(--s-2);margin-bottom:var(--s-3)" id="trend-config-chips">
        <span class="bot-config-chip">EMA(20/50) Crossover</span>
    <span class="bot-config-chip">ADX(14) ≥ 25 filter</span>
    <span class="bot-config-chip">Trend Following — Grid-Search optimiert</span>
    <span class="bot-config-chip">1H Timeframe</span>
    <span class="bot-config-chip">21 FX Pairs</span>
    <span class="bot-config-chip">Long Only</span>
  </div>
  <details style="font-size:var(--text-xs)">
    <summary style="cursor:pointer;color:var(--c-text-dim);user-select:none">Per-Pair Parameters ▸</summary>
    <div style="margin-top:var(--s-2);overflow-x:auto">
      <table class="bot-table" style="font-size:var(--text-xs)" id="trend-pair-params">
        <thead><tr><th>Pair</th><th>RSI Levels</th><th>Strategy</th><th>SL (pips)</th><th>TP (pips)</th><th>R:R</th><th>Exp/Trade</th></tr></thead>
        <tbody id="trend-pair-params-body">
          <tr><td colspan="7" class="bot-no-data">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </details>
</div>


<!-- 10. PERFORMANCE HEATMAP -->
<p class="bot-section-title">🗺️ Pair Performance Heatmap</p>
<div class="bot-card">
  <div class="bot-heatmap-grid" id="trend-heatmap-grid">
    <div class="bot-no-data">Loading heatmap...</div>
  </div>
</div>

<!-- BOT-SPECIFIC SECTIONS (market scan, focus, patterns, etc.) -->


<!-- 11. INIT -->
<script>
BotDash.init({
  prefix: 'trend',
  apiBase: '/api/trend',
  dashboardPath: '/api/trend/dashboard.json',
  chartsPath: '/api/trend/charts/',
  heatmapPath: '/api/trend/performance_heatmap.json',
  refreshInterval: 60000,
  hasEquity: true,
  hasSignals: true,
  hasCandlestick: true,
  hasHeatmap: true,
  hasBacktest: false,
  onData: function(d) {
    
  }
});
</script>

</main>

<script>
if (typeof lucide !== 'undefined') lucide.createIcons();
// Scroll active nav link into view on mobile
document.addEventListener('DOMContentLoaded', function(){
  var active = document.querySelector('.nav a[aria-current="page"]');
  if(active && active.scrollIntoView){
    active.scrollIntoView({inline:'center',behavior:'instant'});
  }
});
</script>
</body>
</html>
