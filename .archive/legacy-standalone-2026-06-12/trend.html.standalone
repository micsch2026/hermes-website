<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hermes</title>
<link rel="stylesheet" href="/assets/base.css">
<script>(function(){var t=localStorage.getItem('theme')||'dark';document.documentElement.className=t;})();</script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

</head>
<body>
<header id="site-header">
<nav class="nav" aria-label="Hauptnavigation">
  <a href="/"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    Dashboard
  </a>
