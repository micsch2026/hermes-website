{
  "_comment": "Beschreibungs-Karte der Portfolio-Übersicht in Alltagssprache. Keys einheitlich: was / gut / nicht. Overrides nach Strategie-ID gewinnen immer, sonst erster Approach-Match auf den Recipe-Namen.",
  "overrides": {
    "194": {
      "tag": "Gold & Silber im Trend",
      "was": "Handelt Metalle (Gold, Silber) nur mit dem etablierten Trend: erst wenn eine klare Richtung steht und der Kurs kurz zurückzieht, steigt er wieder ein. Er schwimmt nie gegen den Strom.",
      "gut": "Solange Gold/Silber eine erkennbare Richtung haben und zwischendurch kleine Rückzieher machen – da nutzt er den Rückzug für einen sauberen Einstieg.",
      "nicht": "Wenn die Metalle seitwärts ohne Linie pendeln: die Einstiege sitzen in keiner klaren Richtung, er kann sich totlaufen und Verluste sammeln."
    },
    "525": {
      "tag": "Metalle gegen die Uebertreibung",
      "was": "Handelt Gold/Silber auf Rückkehr zum Durchschnittsniveau: Entfernt sich der Kurs zu weit vom Normalpreis, wettet er darauf, dass er zurückkehrt.",
      "gut": "Solange Gold/Silber eher seitwärts schwankt – der Kurs wird wie von einem Gummiband wieder zum Niveau zurückgezogen.",
      "nicht": "Bei einer echten Trendwelle bleibt der Kurs lange weit weg vom Band und die Rückkehr-Wette läuft in die falsche Richtung."
    },
    "443": {
      "tag": "Gold nach Ereignis-Sprung",
      "was": "Spielt Gold-Momente, in denen Nachrichten/Volatilität explodieren, und reitet auf dem Momentum, das die Vol-Spitze auslöst.",
      "gut": "Rund um marktbewegende Ereignisse, wo Gold plötzlich einen starken Volatilitäts-Sprung zeigt.",
      "nicht": "Ruhige Phasen ohne Ereignis – ohne den Auslöser fehlt der Antrieb und die Strategie schläft."
    }
  },
  "approaches": [
    {
      "match": ["trend_pullback", "trend_following", "momentum", "adx"],
      "tag": "Mit dem Trend schwimmen",
      "was": "Geht mit einem etablierten Trend rein und reitet die Bewegung, bis die Kraft nachlässt. Sie läuft nie gegen den Strom.",
      "gut": "Klare, anhaltende Bewegungen (z.B. EURUSD, GBPUSD, Indizes) – lange Gewinn-Strecken mit dem Trend.",
      "nicht": "Seitwärts-Märkte: der Kurs irrt hin und her und er sammelt viele kleine Verluste ohne klare Linie."
    },
    {
      "match": ["volume_reversal", "vol_reversal", "mfi", "vol_rev"],
      "tag": "Gegen die schweren Läufe",
      "was": "Erwartet das Übertreiben mit starkem Handelsvolumen und geht eine Gegenbewegung ein, wenn der Preis nach dem Volumen-Plak wieder dreht.",
      "gut": "Wenn plötzlich hohes Volumen in einen Übertreibungs-Höhepunkt endet und der Kurs schnell zurückdreht.",
      "nicht": "Langsame, ruhige Trends ohne Übertreibung – dann gibt es keinen klaren Trigger und es wird abgewartet."
    },
    {
      "match": ["zscore", "z-score"],
      "tag": "Zurueck zum Normalmass",
      "was": "Prüft, ob der Kurs weit über oder unter dem statistischen Normalmass liegt, und handelt die Rückkehr zur Mitte.",
      "gut": "Ruhige Seitwärts-Märkte, in denen der Preis zum Mittelwert zurückfindet.",
      "nicht": "Scharfe Trendwellen: das Extrem hält lange an und die Rückkehr läuft ins Messer."
    },
    {
      "match": ["stochastic", "stoch", "mr"],
      "tag": "Pendel zur Mitte",
      "was": "Spielt auf die Normalisierung: wirkt ein Kurs überreagiert, wird darauf gesetzt, dass er zur Mitte zurückkehrt.",
      "gut": "Seitwärts schwank und nach Übertriebenen Reaktionen.",
      "nicht": "Kräftige Trend- oder hohe Volatilitäts-Tage – da kann die Gegenbewegung ins Messer gegangen werden."
    },
    {
      "match": ["ichimoku", "209_ichimoku"],
      "tag": "Wolke als Fahrbahn",
      "was": "Nutzt das farbige Wolken-System auf Gold: eindeutig über der Wolke long, unter der Wolke short.",
      "gut": "Klare Trend-Tage, wo der Kurs die Wolke deutlich verlässt.",
      "nicht": "In der Zappel-Zone innerhalb der Wolke, wo der Kurs zwischen den Linien pendelt – schwache Signale."
    },
    {
      "match": ["session_pivot", "session", "pivot"],
      "tag": "Am Start der Sitzung",
      "was": "Nutzt die Markteröffnung/Tageswende als Auslöser: entsteht dabei ein Pivot, wird in dessen Richtung gehandelt.",
      "gut": "Am turbulenten Handelsstart, wo der Preis eine klare Richtung aus der Pivot-Zone nimmt.",
      "nicht": "Wenn die Eröffnung ohne klare Richtung bleibt und der Preis in der Pivot-Zone hängen bleibt."
    },
    {
      "match": ["divergence", "rsi_divergence", "kb8_rsi"],
      "tag": "Wendepunkt-Jäger",
      "was": "Kauft/verkauft kurz vor einem möglichen Wendepunkt: Preis läuft noch, aber die unterliegende Kraft schwächt sich ab.",
      "gut": "An gespannten Kursen, in denen ein Trend ausläuft und sich dreht.",
      "nicht": "Frische, starke Trends, die einfach weiterlaufen: die Warnung kommt zu früh und er steht gegen einen laufenden Run."
    },
    {
      "match": ["rsi25", "rsi35", "rsi", "bb_kc", "bot1_rsi", "rev125", "mean_reversion"],
      "tag": "Gegen den Ueberschuss",
      "was": "Handelt auf Überhitzung: Wirkt ein Kurs mit RSI/Bollinger überdreht, setzt er auf die Rückkehr zur Mitte (mit Schutz vor dem Gegen-Trend).",
      "gut": "Seitwärts schwankende Kurse, die zu den Rändern pendeln und zurückkommen.",
      "nicht": "Bei kräftigen Ausbrüchen, wo die Rückkehr in die falsche Richtung läuft."
    },
    {
      "match": ["squeeze", "orb", "breakout", "bb_squeeze", "london_spike", "london", "spike"],
      "tag": "Ausbruch nach der Ruhe",
      "was": "Wartet, bis der Kurs eine ruhige Kompression mit klarer Richtung durchbricht, und schwimmt mit dem Ausbruch.",
      "gut": "Wenn die Spannung nach langer Ruhe in einen klaren Zug Richtung einer Seite entlädt.",
      "nicht": "Fake-Ausbrüche: die Kompression löst scheinbar, aber der Preis kehrt sofort in die Falle zurück."
